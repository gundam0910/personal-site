{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "personal-site",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"routes": [
		{
			"pattern": "geoff-ayap.site",
			"custom_domain": true
		},
		{
			"pattern": "www.geoff-ayap.site",
			"custom_domain": true
		}
	]
}
